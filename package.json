{
  "name": "chair-flight",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js dev",
    "dev:local": "node --env-file=.env.local node_modules/vite/bin/vite.js dev",
    "build": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js build",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "check": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "migrate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs migrate --config src/database/drizzle.config.ts",
    "migrate:local": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs migrate --config src/database/drizzle.config.ts",
    "script:seed-local-db": "node --env-file=.env.local src/tools/seed-local-db.ts",
    "script:pull-content": "node --env-file-if-exists=.env src/tools/pull-content.ts",
    "script:pull-content:local": "node --env-file=.env.local src/tools/pull-content.ts",
    "script:push-content": "node --env-file-if-exists=.env src/tools/push-content.ts",
    "script:push-content:local": "node --env-file=.env.local src/tools/push-content.ts",
    "script:import-learning-objectives": "node src/tools/import-learning-objectives.ts"
  },
  "dependencies": {
    "@fontsource/figtree": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "@types/luxon": "^3.7.6",
    "drizzle-orm": "^0.45.4",
    "katex": "^0.19.1",
    "luxon": "^3.7.2",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.4",
    "yaml": "^2.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@tailwindcss/vite": "^4.3.4",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "drizzle-kit": "^0.31.11",
    "nitro": "3.0.261103-rc",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
