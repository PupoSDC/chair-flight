# Local development settings. Committed on purpose: nothing here is secret.
# Used by `pnpm dev:local`, `migrate:local`, `script:seed-database:local`, `script:pull-database:local`.
# Start the database first with `docker compose up -d --wait`.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/chair_flight
# Public project URL for authentication and other Supabase services.
SUPABASE_URL=https://mjhidynvuozywjcgwqrk.supabase.co
# Annexes are served from the content folders by the dev server.
ANNEX_BASE_URL=/local-annexes
# Accounts, comments and the back office are visible only when this is true.
FEATURE_FLAG_USER_FLOW=false
